# ============================================
# STB Singapore — Environment Configuration
# Add all of these to Vercel Dashboard → Project Settings → Environment Variables
# ============================================

# ─── Site ───
PORT=3003
SITE_URL=https://stb-singapore.com
BRAND_NAME=STB Singapore
BRAND_TAGLINE=Majestic Hospitality Since 2014
LOGO_URL=https://stb-singapore.com/stb-logo.png

# ─── Contact (used in booking emails) ───
CONTACT_PHONE=+65 9062 9107
CONTACT_EMAIL=bala@tensketch.com
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=+6590629107

# ─── SMTP (required for booking email notifications) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=bala@tensketch.com

# ─── Data Storage (Vercel KV — optional) ───
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Google Maps & Places API ───
# Restrict this API key in Google Cloud Console by HTTP referrer:
# Production: https://singaporetourbooking.com/*, https://www.singaporetourbooking.com/*
# Development: http://localhost:3003/*, http://localhost:3000/*
GOOGLE_MAPS_API_KEY=

# ─── Google Analytics 4 ───
GA_MEASUREMENT_ID=G-L1SLZX61TK
GA_DEBUG_MODE=false

# ─── Google Tag Manager (enable when ready) ───
# GTM_CONTAINER_ID=GTM-XXXXXXX

# ─── Google Search Console Verification (optional) ───
# GSC_META_TAG=google-site-verification=xxx

# ─── Bing Webmaster Verification (optional) ───
# BING_META_TAG=msvalidate.01.xxx

# ─── Future Integrations (optional) ───
# CLARITY_PROJECT_ID=
# META_PIXEL_ID=
# LINKEDIN_PARTNER_ID=
# TIKTOK_PIXEL_ID=
