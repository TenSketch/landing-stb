# STB Singapore — Environment Configuration
# Production values imported from Vercel static-hosting project.
# Fill in real secrets for local testing. Do NOT commit production secrets.

PORT=3003
SITE_URL=https://singaporetourbooking.com
BRAND_NAME=STB Singapore
BRAND_TAGLINE=Majestic Hospitality Since 2014
LOGO_URL=https://singaporetourbooking.com/stb-logo.png

# PostgreSQL (Self-Hosted on Hetzner VPS / Local Dev)
# Production: postgresql://stb_app:***@localhost:5432/stb_production
# Development: postgresql://postgres:***@localhost:5432/stb_dev
DATABASE_URL=postgresql://postgres:***@localhost:5432/stb_dev
PG_MAX_CONNECTIONS=10
PG_SSL=false

# Required for encrypting provider secrets at rest
STB_SECRET_KEY=change_this_to_a_32_byte_hex_string_1234

# Initial Super Admin bootstrap email
INITIAL_ADMIN_EMAIL=bala@tensketch.com

# Super Admin OTP/2FA: set to true to require email OTP on every login
SUPER_ADMIN_OTP_REQUIRED=false

# Contact (used in booking emails)
CONTACT_PHONE=+65 9062 9107
CONTACT_EMAIL=bala@tensketch.com
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=+6590629107

# SMTP (required for OTP & booking email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tensketch285@gmail.com
SMTP_PASSWORD=REPLACE_WITH_REAL_APP_PASSWORD
EMAIL_FROM=tensketch285@gmail.com
ADMIN_NOTIFICATION_EMAIL=bala@tensketch.com

# Google Maps & Places API
# Restrict this API key in Google Cloud Console by HTTP referrer:
# Production: https://singaporetourbooking.com/*, https://www.singaporetourbooking.com/*
# Development: http://localhost:3003/*, http://localhost:3000/*
GOOGLE_MAPS_API_KEY=REPLACE_WITH_REAL_API_KEY

# Google Analytics 4
GA_MEASUREMENT_ID=G-L1SLZX61TK
GA_DEBUG_MODE=false
